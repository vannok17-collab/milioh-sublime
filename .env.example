# Supabase — sans ces deux valeurs, l'application tourne automatiquement en mode démo
# (bannière rouge visible, données stockées uniquement dans le navigateur).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Numéro WhatsApp de la boutique, format international SANS le + (indicatif 225 + numéro local sans le 0 initial)
NEXT_PUBLIC_WHATSAPP_NUMBER=225101477411

# Numéros Mobile Money — un par opérateur. Wave est accepté sur les trois numéros,
# donc les trois sont listés (séparés par "ou") pour ce champ.
NEXT_PUBLIC_MOBILE_MONEY_ORANGE=0707 905 222
NEXT_PUBLIC_MOBILE_MONEY_MTN=0545 577 511
NEXT_PUBLIC_MOBILE_MONEY_WAVE=0101 477 411 ou 0707 905 222 ou 0545 577 511
NEXT_PUBLIC_MOBILE_MONEY_MOOV=0101 477 411
